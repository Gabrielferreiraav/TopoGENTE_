<mah:MetroWindow x:Class="TopoGente.UI.Views.ImportarConfiguracaoDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:TopoGente.UI.ViewModels"
        mc:Ignorable="d"
        Title="Importação Inteligente de Caderneta / Coordenadas" Height="650" Width="920"
        Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
        TextElement.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho Informativo -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="FileCogOutline" Width="36" Height="36" 
                                         VerticalAlignment="Center" Foreground="#38BDF8" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Arquivo: " FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding NomeArquivo}" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,16,0"/>
                        <TextBlock Text="Formato: " FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding FormatoDescricao}" Foreground="#38BDF8"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ResumoDeteccao}" Foreground="#A7F3D0" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Controles de Configuração Regional e Numérica -->
        <GroupBox Grid.Row="1" Header="Parâmetros Regionais e Numéricos de Importação" 
                  materialDesign:ColorZoneAssist.Mode="Standard" Margin="0,0,0,12">
            <WrapPanel Margin="4,8" Orientation="Horizontal">
                <!-- Separador Decimal -->
                <StackPanel Width="160" Margin="8,4">
                    <TextBlock Text="Separador Decimal:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding OpcoesSeparadorDecimal}"
                              SelectedItem="{Binding SeparadorDecimalSelecionado, Mode=TwoWay}"
                              ToolTip="Define se o número fracionário utiliza ponto (.) ou vírgula (,)"/>
                </StackPanel>

                <!-- Separador de Milhar -->
                <StackPanel Width="160" Margin="8,4">
                    <TextBlock Text="Separador de Milhar:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding OpcoesSeparadorMilhar}"
                              SelectedItem="{Binding SeparadorMilharSelecionado, Mode=TwoWay}"
                              ToolTip="Define se há separador de milhar nos números"/>
                </StackPanel>

                <!-- Magnitude de Coordenadas -->
                <StackPanel Width="220" Margin="8,4">
                    <TextBlock Text="Magnitude de Coordenadas:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding OpcoesMagnitude}"
                              SelectedItem="{Binding MagnitudeSelecionada, Mode=TwoWay}"
                              ToolTip="UTM Completa (&gt;1.000.000m) ou Coordenadas Locais Truncadas (&lt;1.000.000m)"/>
                </StackPanel>

                <!-- Formato Angular -->
                <StackPanel Width="180" Margin="8,4">
                    <TextBlock Text="Formato Angular:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding OpcoesFormatoAngular}"
                              SelectedItem="{Binding FormatoAngularSelecionado, Mode=TwoWay}"
                              ToolTip="Sexagesimal topoGRAPH (DDD.MMSS), Graus Decimais ou Gradiados/Gons"/>
                </StackPanel>

                <!-- Delimitador (CSV/TXT) -->
                <StackPanel Width="170" Margin="8,4" 
                            Visibility="{Binding ExibeDelimitador, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Delimitador de Coluna:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding OpcoesDelimitador.Keys}"
                              SelectedItem="{Binding DelimitadorNome, Mode=TwoWay}"
                              ToolTip="Caractere delimitador de tokens da linha"/>
                </StackPanel>
            </WrapPanel>
        </GroupBox>

        <!-- Live Preview Reativo -->
        <GroupBox Grid.Row="2" Header="Live Preview Reativo (Validação Linha a Linha)" Margin="0,0,0,12">
            <DataGrid ItemsSource="{Binding LinhasPreview}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      CanUserSortColumns="False"
                      Background="#111827"
                      Foreground="#F3F4F6"
                      AlternatingRowBackground="#1F2937">
                <DataGrid.Columns>
                    <!-- Status de Validação -->
                    <DataGridTemplateColumn Header="Status" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <materialDesign:PackIcon 
                                    Kind="{Binding Valida, Converter={x:Null}}" 
                                    Width="18" Height="18"
                                    HorizontalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="CheckCircle"/>
                                            <Setter Property="Foreground" Value="#10B981"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Valida}" Value="False">
                                                    <Setter Property="Kind" Value="AlertCircle"/>
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Número da Linha -->
                    <DataGridTextColumn Header="#" Binding="{Binding NumeroLinha}" Width="45">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Linha Original -->
                    <DataGridTextColumn Header="Linha Original" Binding="{Binding LinhaOriginal}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas, monospace"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Tokens Parseados -->
                    <DataGridTextColumn Header="Tokens Extraídos" Binding="{Binding TokensVisualizacao}" Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas, monospace"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Foreground" Value="#60A5FA"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Mensagem / Aviso -->
                    <DataGridTextColumn Header="Diagnóstico" Binding="{Binding MensagemAviso}" Width="200">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Foreground" Value="#F59E0B"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Botões de Ação Inferiores -->
        <DockPanel Grid.Row="3" LastChildFill="False">
            <Button DockPanel.Dock="Right" 
                    Command="{Binding ConfirmarCommand}"
                    Content="Confirmar Importação" 
                    Style="{DynamicResource MaterialDesignRaisedButton}"
                    Background="#2563EB" Foreground="White"
                    Width="180" Height="36" Margin="8,0,0,0"/>

            <Button DockPanel.Dock="Right" 
                    Command="{Binding CancelarCommand}"
                    Content="Cancelar" 
                    Style="{DynamicResource MaterialDesignOutlinedButton}"
                    Width="110" Height="36"/>
        </DockPanel>
    </Grid>
</mah:MetroWindow>
