                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="MODELAGEM DIGITAL (MDT)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MahApps.Brushes.AccentBase}" Margin="0,0,0,2"/>
                            <TextBlock Text="Triangulação Delaunay (CDT) e Malha de Terreno" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" Margin="0,0,0,12"/>

                            <!-- Estatísticas da Superfície -->
                            <GroupBox Header="Estatísticas da Superfície (TIN)" Margin="0,0,0,10">
                                <Grid Margin="6,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Total de Triângulos:" Grid.Row="0" Grid.Column="0" Margin="0,3,10,3" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                    <TextBlock Text="{Binding TotalTriangulosMdt, StringFormat='{}{0:N0} elementos'}" Grid.Row="0" Grid.Column="1" Margin="0,3" FontWeight="SemiBold"/>

                                    <TextBlock Text="Vértices da Malha:" Grid.Row="1" Grid.Column="0" Margin="0,3,10,3" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
