                                    <TextBlock Text="Cota Mínima (Z mín):" Grid.Row="2" Grid.Column="0" Margin="0,3,10,3" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                    <TextBlock Text="{Binding CotaMinimaTerreno, StringFormat='{}{0:F3} m'}" Grid.Row="2" Grid.Column="1" Margin="0,3" FontWeight="SemiBold"/>

                                    <TextBlock Text="Cota Máxima (Z máx):" Grid.Row="3" Grid.Column="0" Margin="0,3,10,3" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                    <TextBlock Text="{Binding CotaMaximaTerreno, StringFormat='{}{0:F3} m'}" Grid.Row="3" Grid.Column="1" Margin="0,3" FontWeight="SemiBold"/>

                                    <TextBlock Text="Desnível Total (ΔZ):" Grid.Row="4" Grid.Column="0" Margin="0,3,10,3" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                    <TextBlock Text="{Binding DesnivelTerreno, StringFormat='{}{0:F3} m'}" Grid.Row="4" Grid.Column="1" Margin="0,3" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.AccentBase}"/>
                                </Grid>
                            </GroupBox>

                            <!-- Processamento de Malha -->
                            <GroupBox Header="Processamento de Terreno" Margin="0,0,0,10">
                                <StackPanel Margin="4">
                                    <Button Content="⚡ RECALCULAR MALHA TIN" Command="{Binding RecalcularMalhaCommand}" Margin="0,2,0,6" Height="32" Background="#2D2D30" FontWeight="SemiBold" Cursor="Hand" ToolTip="Regenera a triangulação Delaunay constrained e isolinhas"/>
