                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#8C6B4B" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Cor da camada: Marrom Mestre (#8C6B4B)"/>
                                            <TextBlock Grid.Column="1" Text="Curvas de Nível Mestras" VerticalAlignment="Center" FontSize="12"/>
                                            <ToggleButton Grid.Column="2" Style="{DynamicResource MahApps.Styles.ToggleButton.Switch}" Width="40" Height="18" IsChecked="{Binding MostrarCurvasMestras}" VerticalAlignment="Center" Cursor="Hand"/>
                                        </Grid>
                                    </Border>

