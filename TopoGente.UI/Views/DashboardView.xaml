                            <!-- Altimetria -->
                            <TextBlock Text="ALTIMETRIA" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.AccentBase}" Margin="2,14,0,6"/>

                            <!-- Curvas de Nível Mestras -->
                            <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
