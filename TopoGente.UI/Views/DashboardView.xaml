<UserControl x:Class="TopoGente.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:domain="clr-namespace:TopoGente.Core.Domain;assembly=TopoGente.Core"
             xmlns:viewmodels="clr-namespace:TopoGente.UI.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280"
             Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
             TextElement.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding ProcessarCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource MahApps.Brushes.Control.Background}" Padding="10">
            <Grid>
                <!-- WORKSPACE 1: APOIO PLANIMÉTRICO (Visadas, Poligonal, Diagnóstico/QA e Gerenciador de Camadas) -->
                <Grid Visibility="{Binding EhModuloPlanimetria, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
                    <RadioButton x:Name="TabCaderneta" Content="Visadas" GroupName="Abas" Style="{DynamicResource MahApps.Styles.RadioButton.Toggle}" Margin="4"/>
                    <RadioButton x:Name="TabPoligonal" Content="Poligonal" IsChecked="True" GroupName="Abas" Style="{DynamicResource MahApps.Styles.RadioButton.Toggle}" Margin="4"/>
                    <RadioButton x:Name="TabDiagnostico" Content="Diagnóstico/QA" GroupName="Abas" Style="{DynamicResource MahApps.Styles.RadioButton.Toggle}" Margin="4"/>
                    <RadioButton x:Name="TabCamadas" Content="Camadas" GroupName="Abas" Style="{DynamicResource MahApps.Styles.RadioButton.Toggle}" Margin="4"/>
                </StackPanel>

                <!-- ABA 1 - VISADAS -->
                <Grid Grid.Row="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=TabCaderneta}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Visadas de Campo" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" Margin="0,0,0,10"/>
                            <DataGrid ItemsSource="{Binding VisadasView}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                      HeadersVisibility="Column" Background="{DynamicResource MahApps.Brushes.ThemeBackground}" BorderBrush="#333" BorderThickness="1"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="RowEditEnding">
                                        <i:InvokeCommandAction Command="{Binding RowEditEndingCommand}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <DataGrid.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="{x:Type GroupItem}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                                            <Expander IsExpanded="False" BorderBrush="#555" BorderThickness="0,0,0,1">
                                                                <Expander.Header>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" Margin="5,0"/>
                                                                </Expander.Header>
                                                                <ItemsPresenter />
                                                            </Expander>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </DataGrid.GroupStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Est" Binding="{Binding EstacaoOcupada, Mode=OneWay}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Visado" Binding="{Binding PontoVisado, Mode=TwoWay}"/>
                                    <DataGridTextColumn Header="H. Inst" Binding="{Binding AlturaInstrumento, Mode=OneWay, StringFormat=F3}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="H. Ref" Binding="{Binding AlturaPrisma, Mode=TwoWay, StringFormat=F3}"/>
                                    <DataGridTextColumn Header="Ang. Hor" Binding="{Binding AnguloHorizontal, Mode=TwoWay, StringFormat=F4, UpdateSourceTrigger=LostFocus}"/>
                                    <DataGridTextColumn Header="Ang. Zen" Binding="{Binding AnguloVertical, Mode=TwoWay, StringFormat=F4, UpdateSourceTrigger=LostFocus}"/>
                                    <DataGridTextColumn Header="Dist (m)" Binding="{Binding DistanciaInclinada, Mode=TwoWay, StringFormat=F3}"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo, Mode=OneWay}" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ABA 2 - POLIGONAL -->
                <Grid Grid.Row="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=TabPoligonal}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Configuração da Poligonal" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="Tipo de Fechamento:" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}" Margin="0,0,0,2"/>
                            <ComboBox SelectedIndex="{Binding PoligonalSelecionada.CenarioIndex}" Margin="0,0,0,10"><ComboBoxItem>Enquadrada</ComboBoxItem><ComboBoxItem>Fechada</ComboBoxItem><ComboBoxItem>Aberta Orientada</ComboBoxItem></ComboBox>

                            <GroupBox Header="Sequência do Caminhamento" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Seletor de estações disponíveis -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                                        <ComboBox ItemsSource="{Binding EstacoesDisponiveis}"
                                                  SelectedItem="{Binding EstacaoDisponivelSelecionada}"
                                                  Width="120" Margin="0,0,5,0"
                                                  ToolTip="Estações importadas da caderneta"/>
                                        <Button Content="+ Adicionar" Command="{Binding AdicionarSequenciaCommand}"
                                                ToolTip="Adicionar estação selecionada ao caminhamento"/>
                                    </StackPanel>

                                    <!-- Lista da sequência montada -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ListBox Grid.Column="0"
                                                 ItemsSource="{Binding PoligonalSelecionada.Estacoes}"
                                                 SelectedItem="{Binding EstacaoSequenciaSelecionada}"
                                                 MinHeight="80" MaxHeight="120"
                                                 Background="{DynamicResource MahApps.Brushes.Control.Background}"/>
                                        <StackPanel Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center">
                                            <Button Content="▲" Command="{Binding SubirSequenciaCommand}" Margin="0,2"
                                                    ToolTip="Mover estação para cima na ordem do caminhamento"/>
                                            <Button Content="▼" Command="{Binding DescerSequenciaCommand}" Margin="0,2"
                                                    ToolTip="Mover estação para baixo na ordem do caminhamento"/>
                                            <Button Content="✕" Command="{Binding RemoverSequenciaCommand}" Margin="0,2"
                                                    Foreground="#E57373"
                                                    ToolTip="Remover estação selecionada do caminhamento"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Row="2" Margin="0,3,0,0" FontSize="10"
                                               Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"
                                               Text="Ordem define o caminhamento da poligonal"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Estação de Partida (E0)" Margin="0,0,0,10">
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding PoligonalSelecionada.Estacoes}" SelectedItem="{Binding PoligonalSelecionada.EstacaoAncoragemNome}" Margin="0,0,0,5"/>
                                    <TextBlock Text="Coord X:" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                    <TextBox Text="{Binding PoligonalSelecionada.PartidaX, StringFormat=F3}" Margin="0,0,0,5"/>
                                    <TextBlock Text="Coord Y:" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                    <TextBox Text="{Binding PoligonalSelecionada.PartidaY, StringFormat=F3}" Margin="0,0,0,5"/>
                                    <TextBlock Text="Coord Z:" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                    <TextBox Text="{Binding PoligonalSelecionada.PartidaZ, StringFormat=F3}" Margin="0,0,0,5"/>

                                    <TextBlock Text="Amarração à Ré" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="Ponto de Ré (Referência):" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                    <TextBox Text="{Binding PoligonalSelecionada.NomeRe, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>
                                    <CheckBox IsChecked="{Binding PoligonalSelecionada.UsarCoordenadaRe}" Content="Usar Coordenada ao invés de Azimute" Margin="0,0,0,5"/>
                                    <StackPanel Visibility="{Binding PoligonalSelecionada.MostrarPainelAzimute, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Azimute de Partida:" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                        <TextBox Text="{Binding PoligonalSelecionada.Azimute, StringFormat=F4}" Margin="0,0,0,5"/>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding PoligonalSelecionada.MostrarPainelCoordenadaRe, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Coord X da Ré:" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                        <TextBox Text="{Binding PoligonalSelecionada.ReX, StringFormat=F3}" Margin="0,0,0,5"/>
                                        <TextBlock Text="Coord Y da Ré:" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                        <TextBox Text="{Binding PoligonalSelecionada.ReY, StringFormat=F3}" Margin="0,0,0,5"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Estação de Chegada (En)" Visibility="{Binding PoligonalSelecionada.MostrarPainelChegada, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding PoligonalSelecionada.Estacoes}" SelectedItem="{Binding PoligonalSelecionada.NomeChegada}" Margin="0,0,0,5"/>
                                    <TextBlock Text="Coord X:" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                    <TextBox Text="{Binding PoligonalSelecionada.ChegadaX, StringFormat=F3}" Margin="0,0,0,5"/>
                                    <TextBlock Text="Coord Y:" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                    <TextBox Text="{Binding PoligonalSelecionada.ChegadaY, StringFormat=F3}" Margin="0,0,0,5"/>
                                    <TextBlock Text="Coord Z:" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                    <TextBox Text="{Binding PoligonalSelecionada.ChegadaZ, StringFormat=F3}" Margin="0,0,0,5"/>
                                    <TextBlock Text="Azimute de Chegada:" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                    <TextBox Text="{Binding PoligonalSelecionada.AzimuteChegada, StringFormat=F4}" Margin="0,0,0,5"/>
                                </StackPanel>
                            </GroupBox>

                            <Button Content="→ EXTRAIR CAMINHAMENTO" Command="{Binding ProcessarCommand}" Margin="0,10,0,10" Background="#2D2D30"/>
                            
                            <ListBox ItemsSource="{Binding EstacoesCaminhamento}" Background="{DynamicResource MahApps.Brushes.Control.Background}" MaxHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding NomeEstacao}" FontWeight="Bold" Margin="0,0,10,0" Width="40"/>
                                            <TextBlock Text="{Binding NomeRe, StringFormat='Ré: {0}'}" Foreground="#E57373" Margin="2"/>
                                            <TextBlock Text="{Binding AnguloHorizontalVante, StringFormat='Hz: {0:F4}°'}" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}" Margin="5,2"/>
                                            <TextBlock Text="{Binding NomeVante, StringFormat='Vante: {0}'}" Foreground="#4CAF50" Margin="2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ABA 3 - DIAGNÓSTICO -->
                <Grid Grid.Row="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=TabDiagnostico}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Laudo Técnico de Auditoria (NBR 13.133)" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" Margin="0,0,0,8"/>
                            <ListBox ItemsSource="{Binding RelatorioQaAtual.Checks}" Background="{DynamicResource MahApps.Brushes.Control.Background}" Foreground="#E57373" MinHeight="100" Margin="0,0,0,15"/>

                            <TextBlock Text="Erros de Fechamento" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Angular:" Grid.Row="0" Grid.Column="0" Margin="0,2,10,2" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                <TextBlock Text="{Binding RelatorioQaAtual.ErroAngular}" Grid.Row="0" Grid.Column="1" Margin="0,2" FontWeight="SemiBold"/>
                                
                                <TextBlock Text="Linear (Plani):" Grid.Row="1" Grid.Column="0" Margin="0,2,10,2" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                <TextBlock Text="{Binding RelatorioQaAtual.ErroLinear, StringFormat='{}{0:F4} m'}" Grid.Row="1" Grid.Column="1" Margin="0,2" FontWeight="SemiBold"/>

                                <TextBlock Text="Altimétrico:" Grid.Row="2" Grid.Column="0" Margin="0,2,10,2" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                <TextBlock Text="{Binding RelatorioQaAtual.ErroAltimetrico, StringFormat='{}{0:F4} m'}" Grid.Row="2" Grid.Column="1" Margin="0,2" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ABA 4 - CAMADAS -->
                <Grid Grid.Row="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=TabCamadas}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Gerenciador de Camadas CAD" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" Margin="0,0,0,2"/>
                            <TextBlock Text="Controle de visibilidade das camadas no viewport gráfico" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" Margin="0,0,0,12"/>

                            <!-- Apoio Planimétrico -->
                            <TextBlock Text="APOIO PLANIMÉTRICO" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.AccentBase}" Margin="2,8,0,6"/>

                            <!-- Poligonal Compensada -->
                            <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#1565C0" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Cor da camada: Azul Cobalto (#1565C0)"/>
                                    <TextBlock Grid.Column="1" Text="Poligonal Compensada (NBR)" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" TextTrimming="CharacterEllipsis"/>
                                    <ToggleButton Grid.Column="2" Style="{DynamicResource MahApps.Styles.ToggleButton.Switch}" Width="40" Height="18" IsChecked="{Binding MostrarPoligonalCompensada}" VerticalAlignment="Center" Margin="6,0" Cursor="Hand"/>
                                    <Border Grid.Column="3" CornerRadius="3" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1E4CAF50"/>
                                                <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MostrarPoligonalCompensada}" Value="False">
                                                        <Setter Property="Background" Value="#1A757575"/>
                                                        <Setter Property="BorderBrush" Value="#66757575"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="9" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="VISÍVEL"/>
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MostrarPoligonalCompensada}" Value="False">
                                                            <Setter Property="Text" Value="OCULTO"/>
                                                            <Setter Property="Foreground" Value="#757575"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Esboço de Campo (Poligonal Bruta) -->
                            <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#E65100" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Cor da camada: Âmbar Escuro (#E65100)"/>
                                    <TextBlock Grid.Column="1" Text="Esboço de Campo (Bruta)" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" TextTrimming="CharacterEllipsis"/>
                                    <ToggleButton Grid.Column="2" Style="{DynamicResource MahApps.Styles.ToggleButton.Switch}" Width="40" Height="18" IsChecked="{Binding MostrarEsbocoBruto}" VerticalAlignment="Center" Margin="6,0" Cursor="Hand"/>
                                    <Border Grid.Column="3" CornerRadius="3" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1E4CAF50"/>
                                                <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MostrarEsbocoBruto}" Value="False">
                                                        <Setter Property="Background" Value="#1A757575"/>
                                                        <Setter Property="BorderBrush" Value="#66757575"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="9" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="VISÍVEL"/>
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MostrarEsbocoBruto}" Value="False">
                                                            <Setter Property="Text" Value="OCULTO"/>
                                                            <Setter Property="Foreground" Value="#757575"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Nuvem de Pontos (Vértices) -->
                            <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#2E7D32" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Cor da camada: Verde Floresta (#2E7D32)"/>
                                    <TextBlock Grid.Column="1" Text="Nuvem de Pontos (Vértices)" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" TextTrimming="CharacterEllipsis"/>
                                    <ToggleButton Grid.Column="2" Style="{DynamicResource MahApps.Styles.ToggleButton.Switch}" Width="40" Height="18" IsChecked="{Binding MostrarPontos}" VerticalAlignment="Center" Margin="6,0" Cursor="Hand"/>
                                    <Border Grid.Column="3" CornerRadius="3" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1E4CAF50"/>
                                                <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MostrarPontos}" Value="False">
                                                        <Setter Property="Background" Value="#1A757575"/>
                                                        <Setter Property="BorderBrush" Value="#66757575"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="9" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="VISÍVEL"/>
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MostrarPontos}" Value="False">
                                                            <Setter Property="Text" Value="OCULTO"/>
                                                            <Setter Property="Foreground" Value="#757575"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Modelagem Digital (MDT) -->
                            <TextBlock Text="MODELAGEM DIGITAL (MDT)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.AccentBase}" Margin="2,14,0,6"/>

                            <!-- Triângulos do Terreno (Malha TIN) -->
                            <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#B0BEC5" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Cor da camada: Cinza Suave (#B0BEC5)"/>
