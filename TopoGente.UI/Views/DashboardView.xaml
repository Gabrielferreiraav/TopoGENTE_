                                    <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#D81B60" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Cor da camada: Magenta (#D81B60)"/>
                                            <TextBlock Grid.Column="1" Text="Linhas Obrigatórias (Breaklines)" VerticalAlignment="Center" FontSize="12"/>
                                            <ToggleButton Grid.Column="2" Style="{DynamicResource MahApps.Styles.ToggleButton.Switch}" Width="40" Height="18" IsChecked="{Binding MostrarBreaklines}" VerticalAlignment="Center" Cursor="Hand"/>
                                        </Grid>
                                    </Border>

                                    <!-- Nuvem de Pontos (Referência) -->
                                    <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#2E7D32" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Cor da camada: Verde Floresta (#2E7D32)"/>
                                            <TextBlock Grid.Column="1" Text="Nuvem de Pontos (Referência)" VerticalAlignment="Center" FontSize="12"/>
                                            <ToggleButton Grid.Column="2" Style="{DynamicResource MahApps.Styles.ToggleButton.Switch}" Width="40" Height="18" IsChecked="{Binding MostrarPontos}" VerticalAlignment="Center" Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- WORKSPACE 4: PLANTA GERAL (ENTREGA) -->
                <Grid Visibility="{Binding EhModuloPlantaGeral, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="PLANTA GERAL &amp; PRODUTO CARTOGRÁFICO" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MahApps.Brushes.AccentBase}" Margin="0,0,0,2"/>
                            <TextBlock Text="Visão consolidada do levantamento e exportações técnicas" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" Margin="0,0,0,12"/>

                            <!-- Sumário Cartográfico do Levantamento -->
                            <GroupBox Header="Sumário Cartográfico" Margin="0,0,0,10">
                                <Grid Margin="6,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Arquivo:" Grid.Row="0" Grid.Column="0" Margin="0,3,10,3" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                    <TextBlock Text="{Binding NomeArquivoAtual}" Grid.Row="0" Grid.Column="1" Margin="0,3" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="Status NBR 13.133:" Grid.Row="1" Grid.Column="0" Margin="0,3,10,3" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                    <TextBlock Text="{Binding TextoStatusBar}" Grid.Row="1" Grid.Column="1" Margin="0,3" FontWeight="SemiBold"/>

                                    <TextBlock Text="Pontos Levantados:" Grid.Row="2" Grid.Column="0" Margin="0,3,10,3" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                    <TextBlock Text="{Binding TotalPontos, StringFormat='{}{0:N0} pontos'}" Grid.Row="2" Grid.Column="1" Margin="0,3" FontWeight="SemiBold"/>

                                    <TextBlock Text="Triângulos do Terreno:" Grid.Row="3" Grid.Column="0" Margin="0,3,10,3" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                    <TextBlock Text="{Binding TotalTriangulosMdt, StringFormat='{}{0:N0} triângulos'}" Grid.Row="3" Grid.Column="1" Margin="0,3" FontWeight="SemiBold"/>

                                    <TextBlock Text="Desnível do Relevo:" Grid.Row="4" Grid.Column="0" Margin="0,3,10,3" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                    <TextBlock Text="{Binding DesnivelTerreno, StringFormat='{}{0:F2} m'}" Grid.Row="4" Grid.Column="1" Margin="0,3" FontWeight="SemiBold"/>

                                    <TextBlock Text="Erro Linear Fechamento:" Grid.Row="5" Grid.Column="0" Margin="0,3,10,3" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
                                    <TextBlock Text="{Binding RelatorioQaAtual.ErroLinear, StringFormat='{}{0:F4} m'}" Grid.Row="5" Grid.Column="1" Margin="0,3" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.AccentBase}"/>
                                </Grid>
                            </GroupBox>

                            <!-- Botões de Exportação -->
                            <GroupBox Header="Exportação &amp; Entregáveis" Margin="0,0,0,10">
                                <StackPanel Margin="4">
                                    <Button Content="📐 EXPORTAR PLANTA CAD (DXF)" Command="{Binding ExportarDxfCommand}" Margin="0,3" Height="34" FontWeight="SemiBold" Cursor="Hand" Background="#1565C0" ToolTip="Exporta arquivo DXF de alta compatibilidade para CAD com todas as feições"/>
                                    <Button Content="📄 EXPORTAR COORDENADAS &amp; MEMÓRIA (TXT)" Command="{Binding ExportarTxtCommand}" Margin="0,3" Height="34" FontWeight="SemiBold" Cursor="Hand" Background="#2E7D32" ToolTip="Exporta tabela de coordenadas e memorial descritivo topográfico"/>
                                    <Button Content="📋 EXPORTAR LAUDO TÉCNICO QA (TXT)" Command="{Binding ExportarRelatorioQaCommand}" Margin="0,3" Height="34" FontWeight="SemiBold" Cursor="Hand" Background="#424242" ToolTip="Exporta laudo de auditoria e controle de qualidade NBR 13.133"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Camadas Ativas na Planta Geral -->
                            <GroupBox Header="Camadas Consolidadas na Prancha" Margin="0,0,0,10">
                                <StackPanel Margin="2">
                                    <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#1565C0" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Poligonal Compensada" VerticalAlignment="Center" FontSize="12"/>
                                            <ToggleButton Grid.Column="2" Style="{DynamicResource MahApps.Styles.ToggleButton.Switch}" Width="40" Height="18" IsChecked="{Binding MostrarPoligonalCompensada}" VerticalAlignment="Center" Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#2E7D32" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Nuvem de Pontos" VerticalAlignment="Center" FontSize="12"/>
                                            <ToggleButton Grid.Column="2" Style="{DynamicResource MahApps.Styles.ToggleButton.Switch}" Width="40" Height="18" IsChecked="{Binding MostrarPontos}" VerticalAlignment="Center" Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#8C6B4B" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Curvas de Nível Mestras" VerticalAlignment="Center" FontSize="12"/>
                                            <ToggleButton Grid.Column="2" Style="{DynamicResource MahApps.Styles.ToggleButton.Switch}" Width="40" Height="18" IsChecked="{Binding MostrarCurvasMestras}" VerticalAlignment="Center" Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#6B5B4B" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Curvas de Nível Secundárias" VerticalAlignment="Center" FontSize="12"/>
                                            <ToggleButton Grid.Column="2" Style="{DynamicResource MahApps.Styles.ToggleButton.Switch}" Width="40" Height="18" IsChecked="{Binding MostrarCurvasSecundarias}" VerticalAlignment="Center" Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#D81B60" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Linhas Obrigatórias (Breaklines)" VerticalAlignment="Center" FontSize="12"/>
                                            <ToggleButton Grid.Column="2" Style="{DynamicResource MahApps.Styles.ToggleButton.Switch}" Width="40" Height="18" IsChecked="{Binding MostrarBreaklines}" VerticalAlignment="Center" Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E0E0E0"/>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BARRA DE SELEÇÃO DE WORKSPACES / MÓDULOS -->
            <Border Grid.Row="0" Background="{DynamicResource MahApps.Brushes.Control.Background}" BorderBrush="#33000000" BorderThickness="0,0,0,1" Padding="8,5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <RadioButton Content="📐 Apoio Planimétrico" 
                                 GroupName="Workspaces" 
                                 Style="{DynamicResource MahApps.Styles.RadioButton.Toggle}" 
                                 IsChecked="{Binding EhModuloPlanimetria, Mode=OneWay}"
                                 Command="{Binding MudarModuloCommand}"
                                 CommandParameter="{x:Static viewmodels:WorkspaceModulo.Planimetria}"
                                 Padding="12,4" Margin="2,0" FontWeight="SemiBold" FontSize="12" Cursor="Hand"/>

                    <RadioButton Content="⛰️ Modelagem Digital (MDT)" 
                                 GroupName="Workspaces" 
                                 Style="{DynamicResource MahApps.Styles.RadioButton.Toggle}" 
                                 IsChecked="{Binding EhModuloMdt, Mode=OneWay}"
                                 Command="{Binding MudarModuloCommand}"
                                 CommandParameter="{x:Static viewmodels:WorkspaceModulo.ModelagemMdt}"
                                 Padding="12,4" Margin="2,0" FontWeight="SemiBold" FontSize="12" Cursor="Hand"/>

                    <RadioButton Content="📈 Altimetria (Curvas de Nível)" 
                                 GroupName="Workspaces" 
                                 Style="{DynamicResource MahApps.Styles.RadioButton.Toggle}" 
                                 IsChecked="{Binding EhModuloAltimetria, Mode=OneWay}"
                                 Command="{Binding MudarModuloCommand}"
                                 CommandParameter="{x:Static viewmodels:WorkspaceModulo.Altimetria}"
                                 Padding="12,4" Margin="2,0" FontWeight="SemiBold" FontSize="12" Cursor="Hand"/>

                    <RadioButton Content="🗺️ Planta Geral (Entrega)" 
                                 GroupName="Workspaces" 
                                 Style="{DynamicResource MahApps.Styles.RadioButton.Toggle}" 
                                 IsChecked="{Binding EhModuloPlantaGeral, Mode=OneWay}"
                                 Command="{Binding MudarModuloCommand}"
                                 CommandParameter="{x:Static viewmodels:WorkspaceModulo.PlantaGeral}"
                                 Padding="12,4" Margin="2,0" FontWeight="SemiBold" FontSize="12" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- BARRA DE FERRAMENTAS CAD DEDICADA (DELICADA E CENTRALIZADA NO MEIO DO CAD) -->
            <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="6,3">
                <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="15" Padding="5,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="👆 Inspecionar" Style="{DynamicResource MahApps.Styles.RadioButton.Toggle}" 
                                     IsChecked="{Binding EhModoInspecao, Mode=OneWay}"
                                     Command="{Binding MudarFerramentaCadCommand}" CommandParameter="Inspecao"
                                     Padding="12,3" Margin="2,0" FontSize="11" Cursor="Hand" ToolTip="Inspecionar: clique sobre nós ou feições para consultar coordenadas e atributos"/>
                        <RadioButton Content="⚡ Breakline (MDT)" Style="{DynamicResource MahApps.Styles.RadioButton.Toggle}" 
                                     IsChecked="{Binding EhModoBreakline, Mode=OneWay}"
                                     IsEnabled="{Binding PodeTraçarBreaklines}"
                                     Command="{Binding MudarFerramentaCadCommand}" CommandParameter="Breakline"
                                     Padding="12,3" Margin="2,0" FontSize="11" Cursor="Hand" ToolTip="{Binding TooltipBreaklines}"/>
                        <RadioButton Content="📏 Medir" Style="{DynamicResource MahApps.Styles.RadioButton.Toggle}" 
                                     IsChecked="{Binding EhModoMedicao, Mode=OneWay}"
                                     Command="{Binding MudarFerramentaCadCommand}" CommandParameter="Medicao"
                                     Padding="12,3" Margin="2,0" FontSize="11" Cursor="Hand" ToolTip="Fita métrica dinâmica"/>
                        <Rectangle Width="1" Height="16" Fill="#CCCCCC" Margin="6,0"/>
                        <Button Command="{Binding ZoomExtentsCommand}" Content="🔍 Enquadrar Geral" 
                                Style="{DynamicResource MahApps.Styles.Button.Flat}"
                                Padding="10,3" Margin="2,0" FontSize="11" Cursor="Hand" ToolTip="Enquadrar todas as feições no viewport CAD"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- PRANCHETA CAD COMPARTILHADA (FUNDO BRANCO PURO) -->
            <Border x:Name="ViewportBorder" Grid.Row="2" Background="#FFFFFF" ClipToBounds="True">
                <Grid>
                    <Grid Focusable="True"
                          Background="Transparent"
                          MouseDown="OnCanvasMouseDown"
                          MouseMove="OnCanvasMouseMove"
                          MouseUp="OnCanvasMouseUp"
                          MouseRightButtonDown="OnCanvasRightClick"
                          MouseWheel="OnCanvasMouseWheel"
                          MouseLeave="OnCanvasMouseLeave"
                          PreviewKeyDown="OnCanvasPreviewKeyDown"
                          SizeChanged="OnViewportSizeChanged">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Cursor" Value="Cross"/>
                                <Setter Property="IsHitTestVisible" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTopologyRebuilding}" Value="True">
                                        <Setter Property="Cursor" Value="Wait"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RenderTransform>
                            <MatrixTransform Matrix="{Binding CameraMatrix}"/>
                        </Grid.RenderTransform>

                        <!-- LAYER 1: MDT / COMPENSATED (Só aparece se Compensado) -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EstadoAtualMotor}" Value="{x:Static domain:EstadoMotor.Compensado}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!-- Poligonal Bruta de Referência (Opacidade Suave para Comparação - Âmbar Escuro) -->
                            <Path Data="{Binding StaticDraftGeometry}" Stroke="#E65100" StrokeThickness="0.20" StrokeDashArray="3 2" Opacity="0.45" Visibility="{Binding MostrarEsbocoBruto, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- Poligonal Compensada Oficial NBR 13.133 (Azul Cobalto) -->
                            <Path Data="{Binding StaticPoligonalCompensadaGeometry}" Stroke="#1565C0" StrokeThickness="0.25" Visibility="{Binding MostrarPoligonalCompensada, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- Triângulos TIN (Cinza Suave) -->
                            <Path Data="{Binding StaticTinGeometry}"           Stroke="#B0BEC5" StrokeThickness="0.5" Visibility="{Binding MostrarTin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <!-- Curvas de Nível Secundárias (Marrom Claro) -->
                            <Path Data="{Binding StaticMinorContoursGeometry}" Stroke="#6B5B4B" StrokeThickness="0.5" Visibility="{Binding MostrarCurvasSecundarias, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <!-- Curvas de Nível Mestras (Marrom Escuro) -->
                            <Path Data="{Binding StaticMajorContoursGeometry}" Stroke="#8C6B4B" StrokeThickness="1.5" Visibility="{Binding MostrarCurvasMestras, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <!-- Linhas Obrigatórias / Breaklines (Magenta) -->
                            <Path Data="{Binding StaticBreaklinesGeometry}"    Stroke="#D81B60" StrokeThickness="1.5" Visibility="{Binding MostrarBreaklines, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <!-- Nuvem de Pontos (Verde Floresta Técnico) -->
                            <Path Data="{Binding StaticPointsGeometry}"        Stroke="#2E7D32" StrokeThickness="1.5" Visibility="{Binding MostrarPontos, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>

                        <!-- LAYER 2: DRAFT / BRUTO (Aparece se Bruto ou Reprovado) -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EstadoAtualMotor}" Value="{x:Static domain:EstadoMotor.Compensado}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            
                            <!-- Poligonal Bruta de Campo (Âmbar Escuro) -->
                            <Path Data="{Binding StaticDraftGeometry}" Stroke="#E65100" StrokeThickness="0.20" StrokeDashArray="3 2" Visibility="{Binding MostrarEsbocoBruto, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <!-- Pontos de Campo (Verde Floresta Técnico - Camada Nuvem de Pontos) -->
                            <Path Data="{Binding StaticPointsGeometry}" Stroke="#2E7D32" StrokeThickness="1.5" Visibility="{Binding MostrarPontos, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Path Data="{Binding StaticErrorVectorGeometry}" Stroke="#D32F2F" StrokeThickness="0.4" StrokeDashArray="2 2"/>
                        </Grid>

                        <Path Stroke="#1976D2" StrokeThickness="1" StrokeDashArray="4 2" Data="{Binding DynamicRubberBandGeometry}"/>
                        <Path Stroke="#FFD600" StrokeThickness="1.5" StrokeDashArray="3 3" Data="{Binding DynamicMeasurementGeometry}"/>
                        <Path Data="{Binding SnapMarkerGeometry}" Stroke="#FF6D00" StrokeThickness="1.5" Fill="#33FF6D00"/>
                    </Grid>
                    
                    <!-- HUD DE MEDIÇÃO -->
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" Background="#CC222222" CornerRadius="4" Padding="15,8" IsHitTestVisible="False" Visibility="{Binding TemMedicaoAtiva, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding TextoMedicaoAtual}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                    </Border>
                    <!-- HUD DE INSPEÇÃO -->
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" Background="#CC222222" CornerRadius="4" Padding="15,8" IsHitTestVisible="False" Visibility="{Binding TemInspecaoAtiva, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding TextoInspecaoAtual}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>