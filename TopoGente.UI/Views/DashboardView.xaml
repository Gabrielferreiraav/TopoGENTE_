                                    <ToggleButton Grid.Column="2" Style="{DynamicResource MahApps.Styles.ToggleButton.Switch}" Width="40" Height="18" IsChecked="{Binding MostrarCurvasMestras}" VerticalAlignment="Center" Margin="6,0" Cursor="Hand"/>
