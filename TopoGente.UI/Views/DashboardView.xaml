                                    <TextBlock Text="{Binding CotaMinimaTerreno, StringFormat='{}{0:F3} m'}" Grid.Row="0" Grid.Column="1" Margin="0,3" FontWeight="SemiBold"/>

                                    <TextBlock Text="Cota Máxima (Z máx):" Grid.Row="1" Grid.Column="0" Margin="0,3,10,3" Foreground="{DynamicResource MahApps.Brushes.IdealForegroundDisabled}"/>
