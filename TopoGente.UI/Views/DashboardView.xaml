                                            <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#D81B60" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Cor da camada: Magenta (#D81B60)"/>
                                            <TextBlock Grid.Column="1" Text="Linhas Obrigatórias (Breaklines)" VerticalAlignment="Center" FontSize="12"/>
                                            <ToggleButton Grid.Column="2" Style="{DynamicResource MahApps.Styles.ToggleButton.Switch}" Width="40" Height="18" IsChecked="{Binding MostrarBreaklines}" VerticalAlignment="Center" Cursor="Hand"/>
                                        </Grid>
                                    </Border>

                                    <!-- Nuvem de Pontos -->
                                    <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Background="#2E7D32" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Cor da camada: Verde Floresta (#2E7D32)"/>
